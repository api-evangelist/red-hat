{
  "opencollection": "1.0.0",
  "info": {
    "name": "Red Hat Ansible Automation Platform Add-Ons Groups API",
    "version": "2.6"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Groups",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Red Hat List Groups",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://ansible-platform.example.com/admin/realms/:realm/groups",
            "params": [
              {
                "name": "realm",
                "value": "",
                "type": "path",
                "description": "The name of the Keycloak realm."
              },
              {
                "name": "search",
                "value": "example_value",
                "type": "query",
                "description": "Filter groups by name."
              },
              {
                "name": "first",
                "value": "10",
                "type": "query",
                "description": "Pagination offset."
              },
              {
                "name": "max",
                "value": "10",
                "type": "query",
                "description": "Maximum number of results."
              }
            ]
          },
          "docs": "Retrieves the list of groups in the realm, optionally filtered by name. Groups enable bulk role and attribute assignment to users."
        }
      ]
    }
  ],
  "bundled": true
}