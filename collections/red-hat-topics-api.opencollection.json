{
  "opencollection": "1.0.0",
  "info": {
    "name": "Red Hat Ansible Automation Platform Add-Ons Topics API",
    "version": "2.6"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Topics",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Red Hat List Topics",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://ansible-platform.example.com/insights/v1/topic/"
          },
          "docs": "Retrieves the list of curated Advisor topics that group related rules and recommendations by technology area, risk category, or common concern."
        }
      ]
    }
  ],
  "bundled": true
}