{
  "opencollection": "1.0.0",
  "info": {
    "name": "Red Hat Ansible Automation Platform Add-Ons Roles API",
    "version": "2.6"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Roles",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Red Hat List Realm Roles",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://ansible-platform.example.com/admin/realms/:realm/roles",
            "params": [
              {
                "name": "realm",
                "value": "",
                "type": "path",
                "description": "The name of the Keycloak realm."
              },
              {
                "name": "first",
                "value": "10",
                "type": "query",
                "description": "Pagination offset."
              },
              {
                "name": "max",
                "value": "10",
                "type": "query",
                "description": "Maximum number of results."
              }
            ]
          },
          "docs": "Retrieves the list of realm-level roles that can be assigned to users and groups."
        },
        {
          "info": {
            "name": "Red Hat Create a Realm Role",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://ansible-platform.example.com/admin/realms/:realm/roles",
            "params": [
              {
                "name": "realm",
                "value": "",
                "type": "path",
                "description": "The name of the Keycloak realm."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Creates a new realm-level role."
        }
      ]
    }
  ],
  "bundled": true
}