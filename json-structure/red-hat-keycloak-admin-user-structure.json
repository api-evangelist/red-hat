{
  "$schema": "https://json-structure.org/draft/2020-12/schema",
  "name": "User",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "username": {
      "type": "string"
    },
    "firstName": {
      "type": "string"
    },
    "lastName": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "emailVerified": {
      "type": "boolean"
    },
    "enabled": {
      "type": "boolean"
    },
    "createdTimestamp": {
      "type": "integer"
    },
    "attributes": {
      "type": "object"
    },
    "credentials": {
      "type": "array"
    },
    "requiredActions": {
      "type": "array"
    }
  }
}