{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PaginatedList",
  "type": "object",
  "description": "A generic paginated list response.",
  "properties": {
    "count": {
      "type": "integer"
    },
    "next": {
      "type": "string"
    },
    "previous": {
      "type": "string"
    },
    "results": {
      "type": "array"
    }
  }
}