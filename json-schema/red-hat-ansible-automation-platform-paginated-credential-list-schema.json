  "title": "PaginatedCredentialList",
  "type": "object",
  "description": "A paginated list of credentials.",
  "properties": {
    "count": {
      "type": "integer"
    },
    "next": {
      "type": "string"
    },
    "previous": {
      "type": "string"
    },
    "results": {
      "type": "array"
    }
  }
}